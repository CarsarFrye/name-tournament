{
  "name": "name-tournament",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "tsc --noEmit -p tsconfig.json && vite build --base=/name-tournament/",
    "preview": "vite preview --host 127.0.0.1",
    "check:rules": "node --experimental-strip-types scripts/check-rules.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
